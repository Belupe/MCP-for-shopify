# Credenciales de TU app de Shopify (Dev Dashboard -> tu app -> Settings)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Opcionales
# Puerto local para recibir el callback de OAuth (debe coincidir con la Redirect URL de la app)
# SHOPIFY_REDIRECT_PORT=3457
# Permisos que se piden al iniciar sesión
# SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,read_customers,write_customers,read_content,write_content
# Versión de la Admin API
# SHOPIFY_API_VERSION=2026-07
# Carpeta donde se guardan los tokens (por defecto ~/.config/mcp-for-shopify)
# MCP_SHOPIFY_CONFIG_DIR=
